# ---- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime (Neon: the pooled URL).
DATABASE_URL=
# Direct/unpooled connection used by `prisma migrate` (Neon: DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED=

# ---- Auth ------------------------------------------------------------------
# Secret for Auth.js session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=

# ---- App -------------------------------------------------------------------
# Public origin, no trailing slash. Used in receipt links, WhatsApp share and PDF rendering.
NEXT_PUBLIC_APP_URL=
# One-time token required by /setup to create the first admin. Disabled once an admin exists.
SETUP_TOKEN=

# ---- Uploads ---------------------------------------------------------------
# Vercel Blob read/write token. When empty (local dev) photos are stored in ./uploads.
BLOB_READ_WRITE_TOKEN=

# ---- OTP (claiming order history with a phone number) ----------------------
# console = print the code in the server log (development)
# webhook = POST {phone, code, message} to OTP_WEBHOOK_URL (plug your SMS gateway)
OTP_TRANSPORT=console
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=

# ---- PDF (optional) --------------------------------------------------------
# Local path to a Chrome/Chromium binary for receipt PDFs in development.
# On Vercel, @sparticuz/chromium is used automatically.
CHROME_PATH=
